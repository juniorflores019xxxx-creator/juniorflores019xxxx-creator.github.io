# Reglas para Hostinger (Apache/LiteSpeed).
# HTTPS se fuerza desde el panel de Hostinger (Seguridad → SSL) cuando el certificado esté activo.
ErrorDocument 404 /404.html

# Una sola dirección: www.sibnova.com.bo → sibnova.com.bo
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.sibnova\.com\.bo$ [NC]
  RewriteRule ^(.*)$ https://sibnova.com.bo/$1 [R=301,L]
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
Options -Indexes

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
